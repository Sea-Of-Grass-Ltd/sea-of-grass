; Engine configuration file.
; Proscenium: live animation theatre. See README.md.

config_version=5

[application]

config/name="Proscenium"
config/description="Animated scenes performed live: story on a timeline you can hold and stretch, everything else on a MIDI/OSC-controlled bus."
run/main_scene="res://stage/stage.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

Bus="*res://core/bus.gd"
TexturePool="*res://core/texture_pool.gd"
OscIO="*res://core/osc_io.gd"
Midi="*res://core/midi_in.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="disabled"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
