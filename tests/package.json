{
  "name": "sog-site-tests",
  "private": true,
  "type": "module",
  "description": "Browser tests for the shop pages: user journey first, then the build. Uses the system Chrome.",
  "scripts": {
    "test": "node --test --test-concurrency=1 \"bunnyworld/*.test.mjs\" \"copy/*.test.mjs\"",
